extends Node
## Sound effects (small player pool) and looping music. Autoload "Audio".
## All audio is generated by scripts_tools/generate_audio.py (CC0). Respects
## Settings.sound / Settings.music.

const SFX := ["click", "select", "place", "wrong", "erase", "hint", "complete", "win", "lose"]
const POOL := 6

var _streams := {}
var _players: Array[AudioStreamPlayer] = []
var _music: AudioStreamPlayer

func _ready() -> void:
	for n in SFX:
		_streams[n] = load("res://assets/audio/%s.wav" % n)
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.volume_db = -4.0
		add_child(p)
		_players.append(p)
	var loop: AudioStreamWAV = load("res://assets/audio/music.wav").duplicate()
	loop.loop_mode = AudioStreamWAV.LOOP_FORWARD
	loop.loop_begin = 0
	loop.loop_end = loop.data.size() / 2          # 16-bit mono: frames = bytes / 2
	_music = AudioStreamPlayer.new()
	_music.stream = loop
	_music.volume_db = -13.0
	add_child(_music)
	Settings.changed.connect(_sync_music)
	_sync_music()

func play(sfx: String) -> void:
	if not Settings.sound or not _streams.has(sfx):
		return
	var chosen := _players[0]
	for p in _players:
		if not p.playing:
			chosen = p
			break
	chosen.stream = _streams[sfx]
	chosen.play()

func _sync_music() -> void:
	if Settings.music and not _music.playing:
		_music.play()
	elif not Settings.music and _music.playing:
		_music.stop()
