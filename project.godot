; Engine configuration file. Edited by Godot, comments are not preserved there.
config_version=5

[application]

config/name="Sudoku 3D"
run/main_scene="res://scenes/splash.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icons/icon_192.png"
boot_splash/bg_color=Color(0.94, 0.95, 0.98, 1)
boot_splash/image="res://assets/icons/icon_192.png"
boot_splash/fullsize=false

[autoload]

Settings="*res://autoload/settings.gd"
Audio="*res://autoload/audio.gd"
Stats="*res://autoload/stats.gd"
SaveGame="*res://autoload/save_game.gd"
AdsHook="*res://autoload/ads_hook.gd"
ThemeManager="*res://autoload/theme_manager.gd"
Nav="*res://autoload/nav.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
